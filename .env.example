# CineWeave RAE — local development
# Copy to .env and adjust if needed: cp .env.example .env

# Backend API (used by frontend)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000

# Database
DATABASE_URL=sqlite:///./backend/data/cineweave.db

# Media storage (ingested uploads)
MEDIA_ROOT=./test-media/uploads

# Scoring thresholds
SHIP_THRESHOLD=75.0
FLAG_THRESHOLD=50.0
SYNC_DRIFT_THRESHOLD_MS=120.0

# Optional: install sentence-transformers and set true for ML semantic scoring
ENABLE_ML_SEMANTIC=false
